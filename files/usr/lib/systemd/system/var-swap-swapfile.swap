[Unit]
Description=32 GiB disk swapfile on /var
# Absent wherever make-swapfile skipped (non-btrfs /var, too little room): condition-skip
# rather than a failed unit on every boot.
ConditionPathExists=/var/swap/swapfile

[Swap]
What=/var/swap/swapfile
# Must stay below zram's priority 100 so zram is used first and this is overflow only. At
# 100 the kernel stripes across both; above it, pages go to NVMe while compressed RAM sits
# free. Note that Priority= in this section is ignored when pri= appears in Options=.
Options=pri=10

[Install]
WantedBy=swap.target
